@model LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="card-box">
    <span class="brand-badge">🌿 JKCIP/HADP</span>
    <h1 class="title">Welcome Back</h1>
    <p class="subtitle">Log in to view your farm's crop advisories.</p>

    <div asp-validation-summary="All" class="validation-summary-errors"></div>

    <form asp-action="Login" method="post">
        <input type="hidden" asp-for="ReturnUrl" />
        <div class="form-group">
            <label asp-for="Username" class="form-label"></label>
            <input asp-for="Username" class="form-control" autocomplete="username" />
            <span asp-validation-for="Username" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <button type="submit" class="btn-diagnose">🔑 Log In</button>
    </form>

    <a href="/Account/Register" class="form-link">New here? Register your farm</a>
</div>
