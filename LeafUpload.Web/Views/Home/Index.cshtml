@{
    ViewData["Title"] = "Leaf Diagnosis";

    string FormatLabel(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return string.Empty;
        var parts = raw.Split("___", 2);
        var crop = parts[0].Replace('_', ' ').Trim();
        var disease = parts.Length > 1 ? parts[1].Replace('_', ' ').Trim() : string.Empty;
        return disease.Length == 0 ? crop : $"{crop} — {disease}";
    }

    string? diseaseRaw = ViewBag.Disease as string;
    bool hasResult = !string.IsNullOrEmpty(diseaseRaw);
    bool isHealthy = hasResult && diseaseRaw!.Contains("healthy", StringComparison.OrdinalIgnoreCase);
    double confidencePct = ViewBag.Confidence != null ? Math.Round((double)(float)ViewBag.Confidence * 100, 1) : 0;
}

<div class="card-box">
    <span class="brand-badge">🌿 JKCIP/HADP</span>
    <h1 class="title">Leaf Disease Identification</h1>
    <p class="subtitle">Upload a photo and let the model diagnose it in seconds.</p>

    @if (ViewBag.Error != null)
    {
        <div class="alert-modern">⚠️ @ViewBag.Error</div>
    }

    <form method="post" enctype="multipart/form-data" id="uploadForm">
        <label class="dropzone" id="dropzone">
            <input type="file" name="file" id="fileInput" accept="image/jpeg,image/png,image/webp,image/bmp" required />
            <div id="dzPrompt">
                <div class="dz-icon">📤</div>
                <div class="dz-text">Drop a leaf photo here, or click to browse</div>
                <div class="dz-hint">JPEG, PNG, WEBP or BMP &middot; up to 10&nbsp;MB</div>
            </div>
            <div class="dz-text" id="dzFileName" style="display:none;"></div>
        </label>
        <div class="preview-wrap" id="previewWrap">
            <img id="previewImg" alt="Selected leaf preview" />
        </div>

        <button type="submit" class="btn-diagnose">🔍 Diagnose Leaf</button>
    </form>

    @if (hasResult)
    {
        <div class="result-card @(isHealthy ? "" : "is-warning")">
            <div class="result-head">
                <div class="result-emoji">@(isHealthy ? "✅" : "🩺")</div>
                <div>
                    <div class="result-status">@(isHealthy ? "Looking healthy" : "Diagnosis result")</div>
                    <p class="result-disease">@FormatLabel(diseaseRaw)</p>
                </div>
            </div>

            <div class="confidence-label">
                <span>Confidence</span>
                <span>@confidencePct.ToString("0.0")%</span>
            </div>
            <div class="confidence-track">
                <div class="confidence-fill" id="confidenceFill" data-target="@confidencePct.ToString(System.Globalization.CultureInfo.InvariantCulture)"></div>
            </div>

            <div class="treatment-box">
                <strong>Recommended action</strong>
                @ViewBag.Treatment
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        const dropzone = document.getElementById('dropzone');
        const fileInput = document.getElementById('fileInput');
        const dzPrompt = document.getElementById('dzPrompt');
        const dzFileName = document.getElementById('dzFileName');
        const previewWrap = document.getElementById('previewWrap');
        const previewImg = document.getElementById('previewImg');
        const uploadForm = document.getElementById('uploadForm');
        const loadingOverlay = document.getElementById('loadingOverlay');
        const loadingText = document.getElementById('loadingText');

        function showPreview(file) {
            if (!file) return;
            dzPrompt.style.display = 'none';
            dzFileName.style.display = 'block';
            dzFileName.textContent = '📎 ' + file.name;

            const reader = new FileReader();
            reader.onload = e => {
                previewImg.src = e.target.result;
                previewWrap.style.display = 'block';
            };
            reader.readAsDataURL(file);
        }

        fileInput.addEventListener('change', () => showPreview(fileInput.files[0]));

        ['dragenter', 'dragover'].forEach(evt =>
            dropzone.addEventListener(evt, e => {
                e.preventDefault();
                dropzone.classList.add('drag-over');
            })
        );
        ['dragleave', 'drop'].forEach(evt =>
            dropzone.addEventListener(evt, e => {
                e.preventDefault();
                dropzone.classList.remove('drag-over');
            })
        );
        dropzone.addEventListener('drop', e => {
            const file = e.dataTransfer.files[0];
            if (file) {
                fileInput.files = e.dataTransfer.files;
                showPreview(file);
            }
        });

        uploadForm.addEventListener('submit', () => {
            if (fileInput.files.length > 0) {
                loadingText.textContent = 'Analyzing your leaf…';
                loadingOverlay.classList.add('active');
            }
        });

        const confidenceFill = document.getElementById('confidenceFill');
        if (confidenceFill) {
            requestAnimationFrame(() => {
                requestAnimationFrame(() => {
                    confidenceFill.style.width = confidenceFill.dataset.target + '%';
                });
            });
        }
    </script>
}
